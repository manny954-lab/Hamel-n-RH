# Configuración del servidor Hamelín RH
# Copia este archivo a .env y ajusta los valores según tu entorno.
# NUNCA subas el archivo .env real al control de versiones.

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contraseña_en_produccion
POSTGRES_DB=hamelin_rh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión SQLAlchemy (formato: postgresql+psycopg2://user:pass@host:port/db)
DATABASE_URL=postgresql+psycopg2://postgres:cambiar_esta_contraseña_en_produccion@localhost:5432/hamelin_rh

# -----------------------------------------------------------------------------
# BACKEND (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------
# Clave secreta para firmar JWT. Generar con: openssl rand -hex 32
SECRET_KEY=cambiar_clave_secreta_jwt_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sesión por inactividad (minutos)
SESSION_IDLE_TIMEOUT_MINUTES=60

# Bloqueo tras intentos fallidos de login
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# ALMACENAMIENTO DE ADJUNTOS (justificantes)
# -----------------------------------------------------------------------------
ADJUNTOS_DIR=./data/adjuntos
